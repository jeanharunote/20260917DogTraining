# ===========================================================================
# 대부분의 경우 이 파일은 설정하지 않아도 됩니다.
# ===========================================================================
# Firebase 설정값은 lib/firebase.ts 에 기본값으로 들어가 있어서,
# Netlify 에 아무것도 등록하지 않아도 바로 동작합니다.
#
# 아래는 "다른 Firebase 프로젝트로 바꾸고 싶을 때"만 쓰세요.
# 이 파일을 .env.local 로 복사한 뒤 값을 채우면 기본값보다 우선합니다.
# 배포 환경에서는 Netlify → Site configuration → Environment variables 에 등록하고 재배포하세요.


# ===========================================================================
# Firebase (다른 프로젝트로 바꿀 때만)
# ===========================================================================
# Firebase 콘솔 → 프로젝트 설정(⚙️) → 내 앱 → SDK 설정 및 구성
#
# ℹ️ NEXT_PUBLIC_ 이라 브라우저에 노출되는데 괜찮나요?
#    네. Firebase 웹 설정값은 원래 공개되는 값입니다. 실제 보안은 firestore.rules 가 담당합니다.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=


# ===========================================================================
# Formspree (data/challenge.ts 의 signup.mode 가 "form" 일 때만)
# ===========================================================================
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
